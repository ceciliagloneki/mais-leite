{
    "name": "mais-leite/backend",
    "description": "Backend do projeto Mais Leite (PHP + MySQL).",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.7"
    },
    "scripts": {
        "migrate": "php scripts/migrate.php",
        "seed": "php scripts/seed.php",
        "seed:demo": "php scripts/seed_demo.php",
        "seed-demo": "php scripts/seed_demo.php",
        "serve": "php -S localhost:8090 -t public public/router.php"
    },
    "autoload": {
        "psr-4": {
            "MaisLeiteBackend\\Controllers\\": "src/controllers/",
            "MaisLeiteBackend\\Database\\": "src/database/",
            "MaisLeiteBackend\\Dtos\\Auth\\": "src/dtos/auth/",
            "MaisLeiteBackend\\Dtos\\Funcionarios\\": "src/dtos/funcionarios/",
            "MaisLeiteBackend\\Dtos\\Doadoras\\": "src/dtos/doadoras/",
            "MaisLeiteBackend\\Dtos\\ColetasDomiciliares\\": "src/dtos/coletas-domiciliares/",
            "MaisLeiteBackend\\Dtos\\Recepcoes\\": "src/dtos/recepcoes/",
            "MaisLeiteBackend\\Dtos\\Pasteurizacoes\\": "src/dtos/pasteurizacoes/",
            "MaisLeiteBackend\\Dtos\\Hospitais\\": "src/dtos/hospitais/",
            "MaisLeiteBackend\\Dtos\\Distribuicoes\\": "src/dtos/distribuicoes/",
            "MaisLeiteBackend\\Enums\\": "src/enums/",
            "MaisLeiteBackend\\Middlewares\\": "src/middlewares/",
            "MaisLeiteBackend\\Models\\": "src/models/",
            "MaisLeiteBackend\\Repositories\\": "src/repositories/",
            "MaisLeiteBackend\\Routes\\": "src/routes/",
            "MaisLeiteBackend\\Services\\": "src/services/",
            "MaisLeiteBackend\\Utils\\": "src/utils/"
        }
    }
}
